# Keystatic storage mode (K4).
# - unset or 'local': the default — admin edits write files under src/content/,
#   and build-time reads come from the working tree (no env needed to run locally).
# - 'github': admin edits + build-time reads go to the GitHub app/repo named below.
#   Requires a GitHub OAuth app (login) and a repo-scoped token (build reads).
KEYSTATIC_STORAGE=local

# Required only when KEYSTATIC_STORAGE=github — "owner/name" of the content repo.
KEYSTATIC_GITHUB_REPO=

# Builds read the repo over the GitHub API (getStaticProps + scripts/generate-seo-files).
# A fine-grained token with Contents: read/write on the content repo.
KEYSTATIC_STATIC_GITHUB_TOKEN=
# Optional: branch to read from (defaults to the repo default branch).
KEYSTATIC_GITHUB_REF=

# Keystatic admin login (GitHub OAuth app). Callback URLs:
#   local:  http://localhost:3000/api/keystatic/created-with-keystatic
#   prod:   https://analyttdigital.com/api/keystatic/created-with-keystatic
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random string for signing the login session (openssl rand -hex 32).
KEYSTATIC_SECRET=

# Formspree contact form. Create a form at https://formspree.io, then copy
# the ID from its endpoint (https://formspree.io/f/<form-id>). Form IDs are
# intended for browser use, so this value is public.
NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=

# Google reCAPTCHA v2 checkbox for the contact form. Keep the secret server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

