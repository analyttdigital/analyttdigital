# Keystatic (local repo storage — no GitHub app needed for local dev)
# Switch to kind: 'github' + these vars when wiring Keystatic Cloud / GitHub in CI:
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Visual page builder (see .tasks/visual-page-builder/PROJECT.md section 3.8)
BUILDER_STORAGE=fs
GITHUB_OWNER=
GITHUB_REPO=
BUILDER_BRANCH=main
BUILDER_DRAFT_BRANCH=
GITHUB_TOKEN=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
BUILDER_ALLOWED_USERS=
BUILDER_DEV_BYPASS_AUTH=true
